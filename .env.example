# URL canónica (SEO: canonical, sitemap, Open Graph). Si no se define, en Vercel se usa el dominio de producción.
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com

# Google Tag Manager: ID del contenedor (GTM-XXXXXXX). Tiene prioridad sobre NEXT_PUBLIC_GA_ID.
# El tag de GA4 se configura dentro de GTM. Se carga SÓLO después de que la persona acepta la analítica.
NEXT_PUBLIC_GTM_ID=

# Google Analytics 4 directo, sin GTM: ID de medición (G-XXXXXXXXXX).
# Sin GTM ni GA no se carga ningún script ni se muestra el aviso de cookies.
# Con valor, GA se carga SÓLO después de que la persona acepta la analítica en el aviso.
NEXT_PUBLIC_GA_ID=

# WhatsApp: número real con código de país, sólo dígitos. Ej: 5491100000000
# Sin número no se muestra ningún enlace a WhatsApp (no se inventan números).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Email de contacto real. Se muestra en el footer, en las páginas legales y en el JSON-LD.
# Sin valor no se muestra ninguna dirección (no se inventan emails).
NEXT_PUBLIC_CONTACT_EMAIL=

# Webhook (por ejemplo de n8n) que recibe los leads del formulario. Sólo del lado del servidor.
# Sin él, el formulario valida y responde ok (modo demo) pero los datos no se envían a ningún lado.
N8N_WEBHOOK_URL=
