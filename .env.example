# URL canónica (SEO: canonical, sitemap, Open Graph). Si no se define, en Vercel se usa el dominio de producción.
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com

# Google Analytics 4: ID de medición (G-XXXXXXXXXX). Sin este valor no se carga ningún script de GA.
NEXT_PUBLIC_GA_ID=

# WhatsApp (opcional): número con código de país, sin + ni espacios. Ej: 5491100000000
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Webhook de n8n que recibe los leads del formulario (opcional). Sin él, el formulario sólo valida y responde ok.
N8N_WEBHOOK_URL=
